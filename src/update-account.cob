       >>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. UPDATE-ACCOUNT.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-IDX PIC 9(3) COMP-5.
01 WS-NEW-BALANCE PIC 9(7)V99.

LINKAGE SECTION.

01 LK-ACCOUNT-NO PIC X(10).
01 LK-TRANSACTION-TYPE PIC X.
01 LK-AMOUNT PIC 9(7)V99.
01 LK-SERVICE-FEE PIC 9(7)V99.
01 LK-ACCOUNT-COUNT PIC 9(3) COMP-5.

01 LK-ACCOUNT-TABLE.
   05 LK-ACCOUNT-ENTRY OCCURS 100 TIMES.
      10 LK-TABLE-ACCOUNT-NO PIC X(10).
      10 LK-TABLE-CUSTOMER PIC X(20).
      10 LK-TABLE-BALANCE PIC 9(7)V99.

01 LK-UPDATE-STATUS PIC X.
01 LK-ERROR-CODE PIC X(10).

PROCEDURE DIVISION USING
    LK-ACCOUNT-NO
    LK-TRANSACTION-TYPE
    LK-AMOUNT
    LK-SERVICE-FEE
    LK-ACCOUNT-COUNT
    LK-ACCOUNT-TABLE
    LK-UPDATE-STATUS
    LK-ERROR-CODE.

    MOVE "N" TO LK-UPDATE-STATUS
    MOVE SPACES TO LK-ERROR-CODE

    PERFORM VARYING WS-IDX FROM 1 BY 1
        UNTIL WS-IDX > LK-ACCOUNT-COUNT

        IF LK-TABLE-ACCOUNT-NO(WS-IDX)
            = LK-ACCOUNT-NO

            IF LK-TRANSACTION-TYPE = "C"

                COMPUTE WS-NEW-BALANCE =
                    LK-TABLE-BALANCE(WS-IDX)
                    + LK-AMOUNT
                ON SIZE ERROR
                    MOVE "ERR-006" TO LK-ERROR-CODE
                END-COMPUTE

            ELSE

                COMPUTE WS-NEW-BALANCE =
                    LK-TABLE-BALANCE(WS-IDX)
                    - LK-AMOUNT
                    - LK-SERVICE-FEE
                ON SIZE ERROR
                    MOVE "ERR-006" TO LK-ERROR-CODE
                END-COMPUTE

                IF WS-NEW-BALANCE < 1000
                    MOVE "ERR-005" TO LK-ERROR-CODE
                END-IF

            END-IF

            IF LK-ERROR-CODE = SPACES

                MOVE WS-NEW-BALANCE
                    TO LK-TABLE-BALANCE(WS-IDX)

                MOVE "Y" TO LK-UPDATE-STATUS

            END-IF

        END-IF

    END-PERFORM

    GOBACK.

END PROGRAM UPDATE-ACCOUNT.
