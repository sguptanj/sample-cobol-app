
       >>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. BANKING-APPLICATION.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT ACCOUNT-FILE
        ASSIGN TO "data/accounts.dat"
        ORGANIZATION IS LINE SEQUENTIAL.

    SELECT TRANSACTION-FILE
        ASSIGN TO "data/transactions.dat"
        ORGANIZATION IS LINE SEQUENTIAL.

    SELECT UPDATED-ACCOUNT-FILE
        ASSIGN TO "build/accounts-updated.dat"
        ORGANIZATION IS LINE SEQUENTIAL.

    SELECT REPORT-FILE
        ASSIGN TO "build/transaction-report.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

    SELECT AUDIT-FILE
        ASSIGN TO "logs/audit.log"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.

FD ACCOUNT-FILE.
COPY "account-record.cpy".

FD TRANSACTION-FILE.
COPY "transaction-record.cpy".

FD UPDATED-ACCOUNT-FILE.
01 UPDATED-ACCOUNT-RECORD.
   05 OUT-ACCOUNT-NO PIC X(10).
   05 OUT-CUSTOMER PIC X(20).
   05 OUT-BALANCE PIC 9(7)V99.

FD REPORT-FILE.
01 REPORT-RECORD PIC X(100).

FD AUDIT-FILE.
01 AUDIT-RECORD PIC X(150).

WORKING-STORAGE SECTION.

COPY "account-table.cpy".
COPY "error-codes.cpy".

01 WS-ACCOUNT-COUNT PIC 9(3) COMP-5 VALUE 0.
01 WS-IDX PIC 9(3) COMP-5 VALUE 0.

01 WS-EOF PIC X VALUE "N".

01 WS-ACCOUNT-STATUS PIC X.
01 WS-VALIDATION-STATUS PIC X.
01 WS-LIMIT-STATUS PIC X.
01 WS-UPDATE-STATUS PIC X.

01 WS-RESULT PIC X(10).

01 WS-SERVICE-FEE PIC 9(7)V99.
01 WS-ERROR-CODE-LOCAL PIC X(10).

01 WS-TRANSACTION-COUNT PIC 9(5) COMP-5 VALUE 0.
01 WS-APPROVED-COUNT PIC 9(5) COMP-5 VALUE 0.
01 WS-REJECTED-COUNT PIC 9(5) COMP-5 VALUE 0.

01 WS-REPORT-LINE PIC X(100).
01 WS-AUDIT-LINE PIC X(150).

PROCEDURE DIVISION.

MAIN-PROCESS.

    DISPLAY "===================================="
    DISPLAY " ENTERPRISE BANKING SYSTEM"
    DISPLAY "===================================="

    PERFORM LOAD-ACCOUNTS

    PERFORM PROCESS-TRANSACTIONS

    PERFORM SAVE-ACCOUNTS

    PERFORM DISPLAY-SUMMARY

    STOP RUN.

LOAD-ACCOUNTS.

    DISPLAY "Loading customer accounts..."

    OPEN INPUT ACCOUNT-FILE

    MOVE "N" TO WS-EOF

    PERFORM UNTIL WS-EOF = "Y"

        READ ACCOUNT-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-ACCOUNT-COUNT < 100
                    ADD 1 TO WS-ACCOUNT-COUNT

                    MOVE ACCOUNT-NO
                        TO WS-TABLE-ACCOUNT-NO(
                            WS-ACCOUNT-COUNT)

                    MOVE CUSTOMER-NAME
                        TO WS-TABLE-CUSTOMER(
                            WS-ACCOUNT-COUNT)

                    MOVE ACCOUNT-BALANCE
                        TO WS-TABLE-BALANCE(
                            WS-ACCOUNT-COUNT)
                END-IF
        END-READ

    END-PERFORM

    CLOSE ACCOUNT-FILE

    DISPLAY "Accounts loaded: " WS-ACCOUNT-COUNT.

PROCESS-TRANSACTIONS.

    DISPLAY "Processing transactions..."

    OPEN INPUT TRANSACTION-FILE
    OPEN OUTPUT REPORT-FILE
    OPEN EXTEND AUDIT-FILE

    MOVE "N" TO WS-EOF

    PERFORM UNTIL WS-EOF = "Y"

        READ TRANSACTION-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM PROCESS-TRANSACTION
        END-READ

    END-PERFORM

    CLOSE TRANSACTION-FILE
    CLOSE REPORT-FILE
    CLOSE AUDIT-FILE.

PROCESS-TRANSACTION.

    ADD 1 TO WS-TRANSACTION-COUNT

    MOVE "N" TO WS-UPDATE-STATUS
    MOVE "N" TO WS-ACCOUNT-STATUS
    MOVE "N" TO WS-VALIDATION-STATUS
    MOVE "N" TO WS-LIMIT-STATUS

    MOVE ZERO TO WS-SERVICE-FEE
    MOVE SPACES TO WS-ERROR-CODE-LOCAL

    CALL "VALIDATE-TRANSACTION"
        USING TRANSACTION-TYPE
              TRANSACTION-AMOUNT
              WS-VALIDATION-STATUS

    IF WS-VALIDATION-STATUS NOT = "Y"

        MOVE "ERR-001" TO WS-ERROR-CODE-LOCAL

    ELSE

        CALL "CHECK-TRANSACTION-LIMIT"
            USING TRANSACTION-AMOUNT
                  WS-LIMIT-STATUS

        IF WS-LIMIT-STATUS NOT = "Y"

            MOVE "ERR-004" TO WS-ERROR-CODE-LOCAL

        ELSE

            CALL "VALIDATE-ACCOUNT"
                USING TRANSACTION-ACCOUNT
                      WS-ACCOUNT-COUNT
                      WS-ACCOUNT-TABLE
                      WS-ACCOUNT-STATUS

            IF WS-ACCOUNT-STATUS NOT = "Y"

                MOVE "ERR-003" TO WS-ERROR-CODE-LOCAL

            ELSE

                CALL "CALCULATE-SERVICE-FEE"
                    USING TRANSACTION-TYPE
                          TRANSACTION-AMOUNT
                          WS-SERVICE-FEE

                CALL "UPDATE-ACCOUNT"
                    USING TRANSACTION-ACCOUNT
                          TRANSACTION-TYPE
                          TRANSACTION-AMOUNT
                          WS-SERVICE-FEE
                          WS-ACCOUNT-COUNT
                          WS-ACCOUNT-TABLE
                          WS-UPDATE-STATUS
                          WS-ERROR-CODE-LOCAL

            END-IF

        END-IF

    END-IF

    IF WS-ERROR-CODE-LOCAL = SPACES
        AND WS-UPDATE-STATUS = "Y"

        ADD 1 TO WS-APPROVED-COUNT

        MOVE "APPROVED" TO WS-RESULT

    ELSE

        ADD 1 TO WS-REJECTED-COUNT

        MOVE "REJECTED" TO WS-RESULT

    END-IF

    PERFORM WRITE-TRANSACTION-REPORT

    PERFORM WRITE-AUDIT-LOG.

WRITE-TRANSACTION-REPORT.

    MOVE SPACES TO WS-REPORT-LINE

    STRING
        TRANSACTION-ACCOUNT DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        TRANSACTION-TYPE DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        WS-RESULT DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        WS-ERROR-CODE-LOCAL DELIMITED BY SIZE
        INTO WS-REPORT-LINE
    END-STRING

    MOVE WS-REPORT-LINE TO REPORT-RECORD

    WRITE REPORT-RECORD

    DISPLAY WS-REPORT-LINE.

WRITE-AUDIT-LOG.

    MOVE SPACES TO WS-AUDIT-LINE

    STRING
        TRANSACTION-ACCOUNT DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        TRANSACTION-TYPE DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        WS-RESULT DELIMITED BY SIZE
        " | " DELIMITED BY SIZE
        WS-ERROR-CODE-LOCAL DELIMITED BY SIZE
        INTO WS-AUDIT-LINE
    END-STRING

    MOVE WS-AUDIT-LINE TO AUDIT-RECORD

    WRITE AUDIT-RECORD.

SAVE-ACCOUNTS.

    DISPLAY "Saving updated account balances..."

    OPEN OUTPUT UPDATED-ACCOUNT-FILE

    PERFORM VARYING WS-IDX FROM 1 BY 1
        UNTIL WS-IDX > WS-ACCOUNT-COUNT

        MOVE WS-TABLE-ACCOUNT-NO(WS-IDX)
            TO OUT-ACCOUNT-NO

        MOVE WS-TABLE-CUSTOMER(WS-IDX)
            TO OUT-CUSTOMER

        MOVE WS-TABLE-BALANCE(WS-IDX)
            TO OUT-BALANCE

        WRITE UPDATED-ACCOUNT-RECORD

    END-PERFORM

    CLOSE UPDATED-ACCOUNT-FILE.

DISPLAY-SUMMARY.

    DISPLAY "===================================="
    DISPLAY " BANKING PROCESSING SUMMARY"
    DISPLAY "===================================="

    DISPLAY "Total Transactions: "
        WS-TRANSACTION-COUNT

    DISPLAY "Approved: "
        WS-APPROVED-COUNT

    DISPLAY "Rejected: "
        WS-REJECTED-COUNT

    DISPLAY "===================================="

    DISPLAY "Processing completed."

    DISPLAY "Report: build/transaction-report.txt"
    DISPLAY "Audit: logs/audit.log"

    DISPLAY "====================================".

END PROGRAM BANKING-APPLICATION.

